<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ausblick in Kapitel 10: der Prozesstest des Genehmigungsworkflows als Szenario mit CIB seven Platform Scenario,
  kein Teil einer Übung. Dieselbe Engine im Speicher wie in loesung/prozesstest-java, dasselbe Modell ohne
  External Task (src/main/resources/genehmigungsworkflow-tag1.bpmn), ohne Server und ohne Spring Boot.
  Ein eigenes Projekt, damit nur lädt, wer die Bibliothek aufruft. Anleitung in README.md.

    ./mvnw test             Szenarien ausführen, die Konsole zeigt den Lauf jedes Szenarios über dem Testbaum

  Windows: .\mvnw.cmd statt ./mvnw. Maven selbst ist über .mvn/jvm.config leiser gestellt.
  Welche Elemente und Pfeile des Modells die Szenarien durchlaufen haben, zeigt nach jedem Lauf
  ein HTML-Bericht unter target/process-test-coverage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.miragon.schulung</groupId>
  <artifactId>prozesstest-scenario</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Prozesstest Genehmigungsworkflow als Szenario (Platform Scenario)</name>

  <properties>
    <!-- Voraussetzung der Schulung ist JDK 21, neuere JDKs bauen dasselbe -->
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Kommentare und Anzeigenamen mit Umlauten, auch unter Windows -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Die Testbibliotheken folgen der Version von CIB seven (Maven Central), wie in loesung/prozesstest-java -->
    <cibseven.version>2.2.0</cibseven.version>
    <junit.version>5.14.4</junit.version>
    <h2.version>2.3.232</h2.version>
    <slf4j.version>2.0.17</slf4j.version>

    <!-- CIB seven Process Test Coverage, Community-Extension von CIB seven (Maven Central) -->
    <process-test-coverage.version>2.2.0</process-test-coverage.version>

    <!--
      CIB seven Platform Scenario, Community-Extension von CIB seven (Maven Central). Übersetzt gegen CIB seven 2.0.0,
      läuft hier mit 2.2.0: Die Bibliothek bringt keine eigene Engine mit, sie nimmt die aus cibseven-engine.
    -->
    <platform-scenario.version>2.0.0</platform-scenario.version>
    <mockito.version>5.24.0</mockito.version>

    <!-- Zeichen im Testbaum. Zeigt die Konsole ? statt ✔ und ✘: -Dbaum.theme=ASCII -->
    <baum.theme>UNICODE</baum.theme>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.cibseven.bpm</groupId>
        <artifactId>cibseven-bom</artifactId>
        <version>${cibseven.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Die Engine selbst, im Test mit H2 im Speicher -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @Deployment und die ProcessEngineExtension, auf der die Extension für die Abdeckung aufbaut -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-bpm-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Der Runner: run(...).startByKey(...).execute() startet den Antrag und führt ihn bis zum Ende,
      mit dem Verhalten, das der Test je Wartezustand festlegt. Speicherpunkte und Timer führt er selbst aus.
      Die Bibliothek hängt an keinem Testframework und bringt nichts weiter mit.
    -->
    <dependency>
      <groupId>org.cibseven.community.scenario</groupId>
      <artifactId>cibseven-platform-scenario-runner</artifactId>
      <version>${platform-scenario.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Mockito steht im Test für das Interface ProcessScenario: when(...) legt das Verhalten fest, verify(...) fragt
      nach dem Lauf. Ohne Java Agent, eingestellt unter src/test/resources/mockito-extensions/.
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Abdeckung: ProcessEngineCoverageExtension statt ProcessEngineExtension, die Engine-Klasse dazu steht in
      src/test/resources/camunda.cfg.xml. Nach dem Lauf liegt target/process-test-coverage/<Testklasse>/report.html.
    -->
    <dependency>
      <groupId>org.cibseven.community.process_test_coverage</groupId>
      <artifactId>cibseven-process-test-coverage-junit5-platform-7</artifactId>
      <version>${process-test-coverage.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Logausgabe von Engine und Runner, eingestellt in src/test/resources/simplelogger.properties -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- 3.5.3 ist die Version, gegen die der Tree-Reporter gebaut ist -->
        <version>3.5.3</version>
        <dependencies>
          <dependency>
            <groupId>me.fabriciorby</groupId>
            <artifactId>maven-surefire-junit5-tree-reporter</artifactId>
            <version>1.5.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <!--
            Testausgabe als Baum mit den @DisplayName, wie in loesung/prozesstest-java. Anders als dort bleibt die
            Ausgabe der Tests auf der Konsole an: Über dem Baum steht, was der Runner in jedem Szenario getan hat.
            Die Engine schreibt nur Warnungen (simplelogger.properties).
          -->
          <reportFormat>plain</reportFormat>
          <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter">
            <theme>${baum.theme}</theme>
            <printStacktraceOnError>false</printStacktraceOnError>
            <printStacktraceOnFailure>false</printStacktraceOnFailure>
            <printBlankLineBetweenTests>false</printBlankLineBetweenTests>
          </statelessTestsetInfoReporter>
          <systemPropertyVariables>
            <!-- Ohne Startmeldung von kotlin-logging (Process Test Coverage) über dem Lauf -->
            <kotlin-logging.logStartupMessage>false</kotlin-logging.logStartupMessage>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
